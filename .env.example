# ============================================
# SmallBiz Growth Platform - Environment Variables
# ============================================
# Copy this file to .env.local and fill in your values
# The app runs in DEMO MODE if Supabase keys are missing

# Supabase Configuration
# Get these from your Supabase project dashboard
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Stripe Configuration (Test Mode)
# Get these from https://dashboard.stripe.com/test/apikeys
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Stripe Product IDs (create these in Stripe dashboard)
STRIPE_STARTER_PRICE_ID=
STRIPE_GROWTH_PRICE_ID=

# AI Provider Configuration
# Options: 'stub' (default), 'openai', 'huggingface'
AI_PROVIDER=stub

# OpenAI Configuration (only used if AI_PROVIDER=openai)
OPENAI_API_KEY=
OPENAI_API_BASE=https://api.openai.com/v1

# HuggingFace Configuration (only used if AI_PROVIDER=huggingface)
HUGGINGFACE_API_KEY=

# Analytics Configuration
# Set to 'true' to enable PostHog (requires PostHog keys)
ENABLE_POSTHOG=false
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com

# App Configuration
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=SmallBiz Growth Platform

# Demo Mode
# Set to 'true' to force demo mode even with valid Supabase keys
FORCE_DEMO_MODE=false
